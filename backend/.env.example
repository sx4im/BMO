# Bimo backend env. Copy to backend/.env (or paste into Render → Environment).

# ---------- Supabase ----------
# Project URL: https://app.supabase.com → Project → Settings → API
SUPABASE_URL=
# Service role key (server-side ONLY — never ship to a browser).
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to validate access tokens (Settings → API → JWT secret).
SUPABASE_JWT_SECRET=
# Bucket used for chat attachments (created by migrations/0001_init.sql).
SUPABASE_STORAGE_BUCKET=bimo-attachments

# ---------- Groq (WhatsApp Aeon) ----------
# Get an API key at https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_NEXOS_MODEL=openai/gpt-oss-120b
GROQ_AEON_MODEL=qwen/qwen3.8-27b
# Explicit completion budget for Qwen3.8 (provider output cap16,384).
GROQ_MAX_TOKENS=16384
GROQ_BASE_URL=https://api.groq.com/openai/v1
# ---------- Mistral (Stanza 2.5 and attachment analysis) ----------
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
MISTRAL_VISION_MODEL=ministral-14b-2512
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Boot never runs inference unless an operator explicitly enables this probe.
# BMO_MODEL_STARTUP_PROBE=1

# ---------- NVIDIA image generation ----------
NVIDIA_API_KEY=
# Text-to-image (the "Iris 2.0" mode). Served via NVIDIA's GenAI endpoint
# (separate from the chat endpoint), at {NVIDIA_IMAGE_BASE_URL}/{model}.
# The model is fixed in code (FLUX 3 Klein).
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
# Image request timeout in seconds (default 120).
# NVIDIA_IMAGE_TIMEOUT=120

# ---------- Rate limiting ----------
# Set to 1 to enable per-user/IP limits on chat, upload and search endpoints.
RATELIMIT_ENABLED=0
# When enabled, point this at Redis for accurate limits across multiple
# gunicorn workers (e.g. redis://default:pass@host:6379). In-memory only
# limits each worker independently.
RATELIMIT_STORAGE_URI=memory://

# ---------- Web search & scraping (TinyFish) ----------
# Powers the /search and /scrape routes used for live web search and full page markdown extraction.
# Also powers the autonomous web search Bimo runs on its own during /chat.
# Get an API key at https://tinyfish.ai.
TINYFISH_API_KEY=

# ---------- Autonomous search routing ----------
# Bimo decides per turn whether a question needs live web results. Obvious
# cases are settled by rules at zero cost; the rest go to a small, fast model.
# Groq uses GROQ_API_KEY; without it, the rules alone decide.
SEARCH_CLASSIFIER_MODEL=qwen/qwen3.8-27b
# Hard ceiling on the classifier call, in seconds. On timeout Bimo answers
# without searching rather than making the user wait.
SEARCH_CLASSIFIER_TIMEOUT_S=1.5

# ---------- Voice transcription ----------
# Voice uses Nova-3 streaming tokens; composer transcribes completed recordings.
# Set a Member-permission key on Render for Voice; credentials stay server-side.
DEEPGRAM_API_KEY=
# English default; the Voice language selector chooses a matching Flux voice.
DEEPGRAM_TTS_MODEL=flux-hannah-en
# Nova-3 is selected in code; no separate STT model variable is needed.
# Composer and Voice's recorded-audio recovery use server-side /transcribe.
#
# Voice Auto verifies completed recordings with a Whisper provider for language
# detection. Manual recordings use Deepgram when configured. REST priority:
#   1. TRANSCRIBE_BASE_URL + TRANSCRIBE_API_KEY (OpenAI-compatible REST)
#   2. GROQ_API_KEY (whisper-large-v3)
#   3. OPENAI_API_KEY (whisper-1)
#
# Optional custom REST provider:
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_API_KEY=
# WHISPER_MODEL=whisper-large-v3

# ---------- Voice synthesis (Deepgram Flux) ----------
# Streaming /v2/speak uses the DEEPGRAM_API_KEY above. All 42 supported languages
# have an explicit Flux voice in frontend/js/components/voice-languages.js.

# ---------- Server ----------
PORT=8000
HOST=0.0.0.0

# ---------- CORS ----------
# Comma-separated origins allowed to call the API. Lock down for production.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------- WhatsApp Integration ----------
# Meta Cloud API credentials from developers.facebook.com
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=bimo_whatsapp_verify_token_2026
# From Meta → App settings → Basic. Required to verify inbound webhook POSTs.
WHATSAPP_APP_SECRET=
# WhatsApp Aeon shares the Groq model configured above.
