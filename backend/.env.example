# Bimo backend env. Copy to backend/.env (or paste into Render → Environment).

# ---------- Supabase ----------
# Project URL: https://app.supabase.com → Project → Settings → API
SUPABASE_URL=
# Service role key (server-side ONLY — never ship to a browser).
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to validate access tokens (Settings → API → JWT secret).
SUPABASE_JWT_SECRET=
# Bucket used for chat attachments (created by migrations/0001_init.sql).
SUPABASE_STORAGE_BUCKET=bimo-attachments

# ---------- Mistral AI (Stanza 2.5) ----------
# Powers the Stanza 2.5 model lane (all-round help, id "thinking").
# Get an API key at https://console.mistral.ai/.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ---------- NVIDIA AI endpoints ----------
# Get a key at https://build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Friendly-mode → NVIDIA model IDs (change these on Render to swap models
# without redeploying code). Defaults match the pinned lineup in config.py.
#   NVIDIA_STANZA_MODEL  Stanza 2.5 (all-round help, id "thinking")
#   NVIDIA_NEXOS_MODEL   Nexos 3.0  (deep reasoning, id "deep")
#   NVIDIA_VISION_MODEL  Vision/docs for image & PDF attachments
NVIDIA_STANZA_MODEL=nvidia/nemotron-3-super-120b-instruct
NVIDIA_NEXOS_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_VISION_MODEL=google/diffusiongemma-26b-a4b-it
# Per-reply output token cap. Raise for longer answers / full code builds
# (avoids mid-stream truncation). At ~40 tok/s, 8192 ≈ 3.5 min of output.
NVIDIA_MAX_TOKENS=8192
# Client read timeout (seconds). Keep it above the time to generate
# NVIDIA_MAX_TOKENS at the model's speed, and below the gunicorn --timeout.
NVIDIA_TIMEOUT=540
# SDK automatic retries are disabled. Each explicit fallback reserves usage.

# ---------- Image generation (Iris) ----------
# Text-to-image (the "Iris 2.0" mode). Served via NVIDIA's GenAI endpoint
# (separate from the chat endpoint), at {NVIDIA_IMAGE_BASE_URL}/{model}.
# Uses the same NVIDIA_API_KEY. The model is fixed in code (FLUX 3 Klein).
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
# Image request timeout in seconds (default 120).
# NVIDIA_IMAGE_TIMEOUT=120

# ---------- Rate limiting ----------
# Local development only. Production requires BMO_ENV=production,
# RATELIMIT_ENABLED=1 and one shared Redis/rediss URI for every worker.
BMO_ENV=development
RATELIMIT_ENABLED=0
# Memory is an explicit local/test option. Use shared Redis for hardened
# voice/security state too. Keep its connection credential server-side.
RATELIMIT_STORAGE_URI=memory://
BMO_SECURITY_NAMESPACE=bimo

# Each enabled paid resource needs an operator-chosen positive global daily
# ceiling. Blank values deliberately deny new paid work. See SECURITY_SETUP.md.
BMO_GLOBAL_THINKING_UNITS_PER_DAY=
BMO_GLOBAL_DEEP_UNITS_PER_DAY=
BMO_GLOBAL_AEON_UNITS_PER_DAY=
BMO_GLOBAL_IMAGE_UNITS_PER_DAY=
BMO_GLOBAL_TTS_UNITS_PER_DAY=
BMO_GLOBAL_TRANSCRIBE_UNITS_PER_DAY=
BMO_GLOBAL_SEARCH_UNITS_PER_DAY=
BMO_GLOBAL_SCRAPE_UNITS_PER_DAY=
BMO_MAX_LLM_OUTPUT_TOKENS=4096
# Only for a different vision model: map exact model ID to its documented
# maximum image tokens. Unknown models fail closed; never guess this bound.
BMO_VISION_TOKEN_BUDGETS={}

# Shared voice connection cap, 1-8; current Gunicorn has 16 request threads.
# At most two streams per user. Requires the same Redis as request limits.
BMO_VOICE_MAX_CONNECTIONS=8

# ---------- Web search & scraping (TinyFish) ----------
# Powers the /search and /scrape routes used for live web search and full page markdown extraction.
# Also powers the autonomous web search Bimo runs on its own during /chat.
# Get an API key at https://tinyfish.ai.
TINYFISH_API_KEY=

# ---------- Autonomous search routing ----------
# Bimo decides per turn whether a question needs live web results. Obvious
# cases are settled by rules at zero cost; the rest go to a small, fast model.
# Groq is tried first and Mistral second, using GROQ_API_KEY / MISTRAL_API_KEY.
# With neither key set, the rules alone decide.
SEARCH_CLASSIFIER_MODEL=qwen/qwen3.8-27b
# Hard ceiling on the classifier call, in seconds. On timeout Bimo answers
# without searching rather than making the user wait.
SEARCH_CLASSIFIER_TIMEOUT_S=1.5

# ---------- Voice transcription ----------
# Most browsers do LIVE speech-to-text on-device via the Web Speech API, so no
# server key is needed there. When the on-device engine is unavailable (e.g.
# Firefox) or can't reach its speech service, the app records audio, converts
# it to 16 kHz mono WAV in the browser, and POSTs it to /transcribe.
#
# /transcribe resolves a provider in this order:
#   1. NVIDIA whisper-large-v3 via Riva gRPC — uses NVIDIA_API_KEY (above).
#      IMPORTANT: NVIDIA's whisper is NOT a REST endpoint; it is served over
#      Riva gRPC at grpc.nvcf.nvidia.com:443 with a function-id. Requires the
#      nvidia-riva-client package (in requirements.txt). No extra key needed —
#      the same NVIDIA_API_KEY used for chat works here.
#   2. TRANSCRIBE_BASE_URL + TRANSCRIBE_API_KEY  (any OpenAI-compatible REST)
#   3. GROQ_API_KEY  (Groq free tier, REST whisper-large-v3)
#   4. OPENAI_API_KEY  (REST whisper-1)
#
# Optional Riva overrides (defaults target openai/whisper-large-v3 on NVCF):
# RIVA_SERVER=grpc.nvcf.nvidia.com:443
# RIVA_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
#
# Optional REST fallback:
GROQ_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_API_KEY=
# WHISPER_MODEL=whisper-large-v3

# ---------- Voice synthesis (text-to-speech, Bimo Voice) ----------
# The voice assistant reads replies aloud with NVIDIA magpie-tts-multilingual,
# served over Riva gRPC at grpc.nvcf.nvidia.com:443. It uses the same
# NVIDIA_API_KEY as chat — no extra key needed. These are optional overrides:
#   TTS_VOICE         Magpie-Multilingual.{LOCALE}.{Speaker}
#                     (e.g. EN-US.Aria / EN-US.Jason / EN-US.Leo; also
#                      FR-FR, ZH-CN, VI-VN, ES-US, DE-DE locales).
#   TTS_LANGUAGE      BCP-47 language code for the text (default en-US).
#   TTS_SAMPLE_RATE   Output sample rate in Hz (default 44100).
# TTS_VOICE=Magpie-Multilingual.EN-US.Aria
# TTS_LANGUAGE=en-US
# TTS_SAMPLE_RATE=44100
# MAGPIE_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
# RIVA_TTS_SERVER=grpc.nvcf.nvidia.com:443

# ---------- Server ----------
PORT=8000
HOST=0.0.0.0

# ---------- CORS ----------
# Comma-separated origins allowed to call the API. Lock down for production.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Required in production: independent random secret shared only by Worker/Render.
BMO_EDGE_TOKEN=
# Optional rotation only, expires within one hour (Unix epoch seconds).
BMO_EDGE_TOKEN_PREVIOUS=
BMO_EDGE_TOKEN_PREVIOUS_EXPIRES_AT=

# Mandatory in production; explicitly optional for local development only.
TURNSTILE_ENABLED=0
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=

# ---------- WhatsApp Integration ----------
# Meta Cloud API credentials from developers.facebook.com
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Independent random secret of at least 32 characters; server-only accounting pseudonyms.
BMO_WHATSAPP_IDENTITY_PEPPER=
# From Meta → App settings → Basic. Required to verify inbound webhook POSTs.
WHATSAPP_APP_SECRET=
# WhatsApp Aeon model config (defaults to Groq for ultra-fast replies)
GROQ_AEON_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
